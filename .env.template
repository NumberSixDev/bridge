# DragSim server connection
MINECRAFT_HOST=dragsim.co
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.4
MINECRAFT_CHAT_COMMAND=/gc
# Leave the profile selector before enabling guild chat.
MINECRAFT_JOIN_COMMAND="/warp hub"

# Fill these in later. Microsoft sign-in happens when the bot is started.
MINECRAFT_EMAIL=""
DISCORD_TOKEN=""

# One Discord text channel for the whole guild
DISCORD_SERVER_ID=
MEMBER_CHANNEL_ID=
STAFF_COMMAND_CHANNEL_ID=1569792569418977330

# Optional access to /command, /slowmode and /terminate.
# Leave both blank to prevent anyone from using these staff commands.
BOT_OWNER_ID=
STAFF_ROLE_ID=

MINECRAFT_CHAT_SEPARATOR=">"
DISCORD_IGNORE_PREFIX=")"
USE_PROFANITY_FILTER=true
USE_FIRST_WORD_OF_AUTHOR_NAME=false
# Recruitment controls are limited to these two Discord roles.
RECRUITMENT_ALLOWED_ROLE_IDS=1569762077592125510,1569548424884387850
RECRUITMENT_CHANNEL_ID=
RECRUITMENT_DATA_DIR=.bridge-data
RECRUITMENT_API_BASE_URL=https://dragsim.co/api/
# Purge treats incomplete networth valuations as review-only unless explicitly enabled.
PURGE_ALLOW_PARTIAL_NETWORTH=false
# These usernames never appear in purge panels and can never be kicked by purge.
PURGE_PROTECTED_USERNAMES=
REMINDER_ENABLED=false
# Deprecated compatibility setting; recruitment is disabled until its own panel enables it.
GUILD_AUTO_ACCEPT_ENABLED=false
REMINDER_MESSAGE=""
REMINDER_FREQUENCY=60
